# ========================================
# 课影 EduCast — 环境变量配置模板
# 复制为 .env 并填入真实值
# ========================================

# ---------- 数据库 ----------
DATABASE_URL=sqlite+aiosqlite:///./educast.db

# ---------- 存储 ----------
STORAGE_ROOT=./storage

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173"]

# ---------- Provider API Keys ----------
# 智谱 GLM-4.7-Flash（免费，2026-01 起替代 GLM-4.5-Flash）
# 注意：LLM 多模型路由（Claude / OpenAI / GLM / DeepSeek）已迁移至前端
# 「LLM 管理」页面（/admin/llm），API Key 与型号在数据库中管理。
# 此处的 ZHIPU_API_KEY 仅作为「未在前端配置任何 provider 时」的零配置回退。
ZHIPU_API_KEY=

# CogVideoX（视频生成）
COGVIDEO_API_KEY=

# 数字人 API
DIGITAL_HUMAN_API_KEY=

# ---------- LLM（智谱 GLM）----------
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_TIMEOUT=60.0

# ---------- 生成式片段（智谱 CogVideoX，模块五）----------
# CogVideoX 与 GLM 同平台；COGVIDEO_API_KEY 留空时自动回退用 ZHIPU_API_KEY
COGVIDEO_BASE_URL=https://open.bigmodel.cn/api/paas/v4
COGVIDEO_MODEL=cogvideox-flash
VIDEO_GEN_TIMEOUT=300.0
VIDEO_GEN_POLL_INTERVAL=5.0

# ---------- 数字人（模块四）----------
# 本地兜底讲师画中画的姓名条文本（真机 API 到位后由 Provider 决定形象）
DIGITAL_HUMAN_AVATAR_NAME=AI 讲师

# ---------- 公式动画（公式渲染画面）----------
# auto=探测到 manim+LaTeX 则用 manim，否则降级图片显影；可强制 manim / image
FORMULA_ENGINE=auto

# ---------- TTS ----------
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 路由与成本控制 ----------
DEFAULT_ROUTING_STRATEGY=free_first
MAX_COST_PER_TASK=10.0
MAX_COST_PER_PROJECT=100.0
# 付费能力费率（元/秒），用于生成前成本预估
DIGITAL_HUMAN_COST_PER_SEC=0.5
VIDEO_GEN_COST_PER_SEC=1.0
GEN_CLIP_SECONDS=5.0
TTS_CHARS_PER_SEC=4.0

# ---------- 视频合成（模块三）----------
# FFmpeg/ffprobe 可执行名或绝对路径（默认依赖 PATH）
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
# 课件页渲染字体；留空则自动探测系统 CJK 字体（Windows 回退 msyh.ttc）
SLIDE_FONT_PATH=
# ---------- 认证 / JWT ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 视频水印 ----------
# 可见水印文本；留空则使用课程标题
WATERMARK_TEXT=
# 水印图片路径（可选，留空则仅用文字水印）
WATERMARK_IMAGE_PATH=
# 水印透明度 0.0~1.0
WATERMARK_OPACITY=0.3

# ---------- AI 全自动生成 ----------
# true 时上传后跳过脚本审核，直接 AI 全自动生成成片（演示用；默认关闭）
AI_FULL_GEN_DEFAULT=false
# 分镜无旁白音频时的兜底时长（秒）
SILENT_SCENE_DURATION=4.0

# ---------- 视觉增强（转场 / 片头片尾）----------
# true 时分镜间用 xfade 转场替代无损拼接（重编码，提升观感但耗时略增）
VIDEO_TRANSITIONS=false
# true 时首尾插入动态片头/片尾片段
VIDEO_INTRO_OUTRO=false
# 转场时长（秒）
TRANSITION_DURATION=0.5
# 片头/片尾时长（秒）
INTRO_DURATION=4.0
OUTRO_DURATION=3.0

# ---------- 流水线 ----------
# True 时上传后跨过人工审核，自动生成成片（演示用；默认保持人在环）
SKIP_REVIEW=false

# ---------- 邮件验证码 ----------
# Resend API 密钥（https://resend.com 获取，cloud-mail 部署后在后台查看）
RESEND_API_KEY=
# 发件人地址（必须是 Resend 验证过的域名）
EMAIL_FROM=EduCast <noreply@yourdomain.com>
# 验证码有效期（分钟）
VERIFICATION_CODE_EXPIRE_MINUTES=10
# 同邮箱重发冷却时间（秒）
VERIFICATION_CODE_COOLDOWN_SECONDS=60
# 验证码最大验证尝试次数
VERIFICATION_CODE_MAX_ATTEMPTS=5
